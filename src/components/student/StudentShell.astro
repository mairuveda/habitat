---
import ClassLibrary from "./ClassLibrary";
const menu = ["Inicio", "Clases", "Mi práctica", "Favoritos", "Mi progreso", "Mensajes", "Ajustes"];
---
<div class="student-app">
  <aside>
    <a href="/" class="student-brand"><img src="/brand/habitat-logo.png" alt="Hábitat" /></a>
    <nav>
      {menu.map((label, index) => <a class={index === 0 ? "active" : ""} href="#">{label}</a>)}
    </nav>
    <a class="logout" href="/alumnos">Cerrar sesión</a>
  </aside>
  <section class="student-main">
    <div class="student-header">
      <div><h1>¡Bienvenida, Camila!</h1><p>Este es tu espacio para fluir en movimiento.</p></div>
    </div>
    <ClassLibrary client:load />
  </section>
</div>
<style>
  .student-app { min-height: 100vh; display: grid; grid-template-columns: 230px 1fr; background: #fff8ee; }
  aside { background: linear-gradient(180deg, #4d2b1d, #321b13); color: #fff7ee; padding: 24px 18px; display: flex; flex-direction: column; min-height: 100vh; }
  .student-brand { display: block; padding: 0 8px 20px; }
  .student-brand img { width: 145px; height: 90px; object-fit: contain; filter: brightness(1.5); }
  nav { display: grid; gap: 7px; }
  nav a { padding: 13px 16px; border-radius: 9px; color: #f6dfce; font-size: .9rem; }
  nav a.active, nav a:hover { background: var(--habitat-orange-strong); color: #fff; }
  .logout { margin-top: auto; padding: 14px 16px; color: #f6dfce; }
  .student-main { padding: 34px 38px 50px; overflow: hidden; }
  .student-header h1 { margin: 0; font-size: 1.65rem; }
  .student-header p { margin: 4px 0 18px; color: var(--habitat-muted); }
  :global(.library-toolbar) { display: flex; justify-content: space-between; gap: 16px; align-items: center; margin: 18px 0 14px; }
  :global(.filters) { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  :global(.filters select), :global(.search) { min-height: 40px; border: 1px solid var(--habitat-border); background: #fff; border-radius: 8px; padding: 0 12px; color: var(--habitat-chocolate); }
  :global(.filters button) { border: 0; background: transparent; color: var(--habitat-muted); }
  :global(.search) { width: 220px; }
  :global(.library > h2) { margin: 16px 0 14px; font-size: 1.15rem; }
  :global(.class-cards) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  :global(.class-card) { overflow: hidden; background: #fffdf9; border: 1px solid var(--habitat-border); border-radius: 12px; }
  :global(.thumb-wrap) { height: 160px; position: relative; overflow: hidden; background: #ead9c8; }
  :global(.thumb-wrap img) { width: 100%; height: 100%; object-fit: cover; }
  :global(.duration), :global(.category) { position: absolute; z-index: 1; font-size: .72rem; border-radius: 999px; padding: 4px 8px; }
  :global(.duration) { left: 8px; top: 8px; background: #fff; }
  :global(.category) { left: 8px; bottom: 8px; background: var(--habitat-orange-strong); color: #fff; }
  :global(.class-body) { padding: 12px; }
  :global(.class-body h3) { margin: 0 0 4px; font-size: 1rem; }
  :global(.class-body p) { margin: 0 0 8px; color: var(--habitat-muted); font-size: .82rem; }
  :global(.class-body span) { font-size: .75rem; }
  :global(.class-card) { text-align: left; padding: 0; color: inherit; font: inherit; cursor: pointer; }
  :global(.class-card:hover) { transform: translateY(-2px); box-shadow: 0 12px 30px rgb(72 38 25 / .08); }
  :global(.library-status) { color: var(--habitat-muted); font-size: .8rem; }
  :global(.empty) { padding: 30px; text-align: center; color: var(--habitat-muted); }
  :global(.player-backdrop) { position: fixed; inset: 0; z-index: 100; background: rgb(35 20 13 / .72); display: grid; place-items: center; padding: 24px; }
  :global(.player-modal) { width: min(880px, 100%); max-height: 90vh; overflow: auto; position: relative; background: #fffaf2; border-radius: 18px; padding: 16px; box-shadow: 0 30px 80px rgb(0 0 0 / .25); }
  :global(.player-close) { position: absolute; z-index: 2; right: 25px; top: 25px; width: 38px; height: 38px; border: 0; border-radius: 50%; background: rgb(255 255 255 / .92); font-size: 1.5rem; }
  :global(.player-frame) { aspect-ratio: 16 / 9; overflow: hidden; border-radius: 12px; background: #2b1b14; }
  :global(.player-frame video) { width: 100%; height: 100%; display: block; background: #000; }
  :global(.player-placeholder) { width: 100%; height: 100%; display: grid; place-items: center; align-content: center; gap: 8px; text-align: center; color: #fff4e7; padding: 30px; }
  :global(.player-placeholder span) { width: 68px; height: 68px; display: grid; place-items: center; border-radius: 50%; background: var(--habitat-orange-strong); font-size: 1.6rem; }
  :global(.player-placeholder p) { max-width: 500px; color: #e9d8c9; }
  :global(.player-modal > h3) { margin: 14px 4px 2px; }
  :global(.player-modal > p) { margin: 0 4px 6px; color: var(--habitat-muted); }
  @media (max-width: 980px) { :global(.class-cards) { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 720px) {
    .student-app { grid-template-columns: 1fr; }
    aside { min-height: auto; padding: 12px 16px; flex-direction: row; align-items: center; position: sticky; top: 0; z-index: 10; }
    .student-brand img { width: 100px; height: 55px; }
    aside nav { display: none; }
    .logout { margin-left: auto; margin-top: 0; font-size: .82rem; }
    .student-main { padding: 24px 16px; }
    :global(.library-toolbar) { align-items: stretch; flex-direction: column; }
    :global(.search) { width: 100%; }
    :global(.class-cards) { grid-template-columns: 1fr; }
  }
</style>
