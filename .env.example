# =========================
# BUILD variables (browser)
# =========================
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidad: si ya usás este nombre, sigue funcionando.
PUBLIC_SUPABASE_ANON_KEY=

PUBLIC_CLOUDINARY_CLOUD_NAME=
PUBLIC_CLOUDINARY_API_KEY=
PUBLIC_CLOUDINARY_UPLOAD_PRESET=habitat_private

# =========================
# RUNTIME Worker variables
# =========================
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
# Secret, nunca PUBLIC_*. Preferido en 2026:
SUPABASE_SECRET_KEY=
# Compatibilidad legacy:
SUPABASE_SERVICE_ROLE_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=habitat_private
# Secret, nunca PUBLIC_*.
CLOUDINARY_API_SECRET=
