# Hábitat — configuración canónica
#
# Una sola fuente de configuración:
# - el Worker lee estas variables en runtime;
# - GET /api/config expone únicamente los valores públicos al navegador;
# - los secretos nunca salen del Worker.
#
# Copiá este archivo como .env para desarrollo local.
# .env está ignorado por git.

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_UPLOAD_PRESET=habitat_private
CLOUDINARY_API_SECRET=
