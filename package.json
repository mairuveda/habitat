{
  "name": "habitat-pilates",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && tsc -p tsconfig.worker.json --noEmit && astro build",
    "preview": "pnpm run build && wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy": "pnpm run build && wrangler deploy",
    "check": "astro check && tsc -p tsconfig.worker.json --noEmit",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:integration": "node --experimental-strip-types --test tests/integration/*.test.ts",
    "preview:share": "pnpm run build && wrangler dev --ip 127.0.0.1 --port 8787 --tunnel",
    "security:check": "pnpm test && pnpm run check && pnpm run build",
    "security:audit": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@supabase/supabase-js": "2.112.4",
    "astro": "7.2.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "4.20260702.1",
    "@types/node": "^26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "5.9.3",
    "wrangler": "4.127.1"
  },
  "packageManager": "pnpm@10.15.1"
}
